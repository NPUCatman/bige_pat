{
  "name": "bige-pat-local",
  "version": "0.1.0",
  "private": true,
  "description": "使用比格动作素材的本地桌宠，基于 dsh-pet 0.3.7",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-bige.mjs",
    "stop": "node scripts/stop-bige.mjs",
    "check": "node scripts/start-bige.mjs --check",
    "build": "npm --prefix dsh-pet run build",
    "test": "npm --prefix dsh-pet test",
    "assets": "python scripts/build_bige_assets.py",
    "package:win": "node scripts/package-win.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "rcedit": "5.0.2",
    "yazl": "3.3.1"
  }
}
